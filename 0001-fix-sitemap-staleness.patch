 app/sitemap.ts      | 29 +++++++++++++++++++++++++++--
 lib/slugify.ts      | 33 ++++++++++++++++++++++++++++++++-
 sync-video.ts       |  5 ++++-
 4 files changed, 68 insertions(+), 5 deletions(-)

