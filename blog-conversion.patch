+
+/// Hand-written blog articles. Nothing here is pulled from YouTube: the
+/// title, excerpt (meta description) and body are authored in /admin.
+/// `youtubeId` is only used to embed the related video on the article.
+model Post {
+  id          String    @id @default(cuid())
+  slug        String    @unique
+  title       String
+  excerpt     String
+  body        String    @db.Text
+  youtubeId   String?
+  coverImage  String?
+  topic       String?
+  published   Boolean   @default(false)
+  publishedAt DateTime?
+  createdAt   DateTime  @default(now())
+  updatedAt   DateTime  @updatedAt
+
+  @@index([published, publishedAt])
+}
