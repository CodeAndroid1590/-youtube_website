# Copy this file to .env (or set these in your Vercel project's Environment
# Variables) and fill in real values. Never commit actual secrets.

# Postgres connection string used by Prisma.
DATABASE_URL=

# YouTube Data API v3 key, used by the admin panel to fetch video metadata.
YOUTUBE_API_KEY=

# Password required to log into /admin. Choose something long and random —
# this is the only thing standing between the public internet and your
# video database's add/edit/delete controls.
ADMIN_PASSWORD=

# Public URL of this deployment, no trailing slash. Used for canonical tags,
# the sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://devnesthub.com

# The YouTube channel this site sends "Subscribe" / "Watch on YouTube"
# traffic to.
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@AIWiredOfficial159
